DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx

# Database — PostgreSQL by default. To use SQLite instead for a quick local test,
# comment out DB_ENGINE (or set it to django.db.backends.sqlite3) and the app
# falls back to a db.sqlite3 file automatically.
DB_ENGINE=django.db.backends.postgresql
DB_NAME=mati_db
DB_USER=mati_user
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432
